{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "riftbound-ui",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "ui"
      ],
      "port": 5173
    },
    {
      "name": "riftbound-server",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "server"
      ],
      "port": 8787
    },
    {
      "name": "riftbound-static",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "vite",
        "preview",
        "--port",
        "4173",
        "--base",
        "/RiftboundPlayer/"
      ],
      "port": 4173,
      "url": "http://localhost:4173"
    }
  ]
}